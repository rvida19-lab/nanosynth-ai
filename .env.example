# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
#   cp .env.example .env

# ── Anthropic API key ──────────────────────────────────────────────────────
# Optional. If set, the server uses this key and the UI key field can be left
# blank — convenient when running locally for yourself.
#
# Do NOT set this on a public deployment: every visitor's generations would be
# billed to you, and nothing stops one person running thousands. The hosted
# instance is bring-your-own-key for exactly this reason.
#
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── NCBI E-utilities key ───────────────────────────────────────────────────
# Optional but recommended. Raises the PubMed rate limit from 3 to 10
# requests/sec. NCBI limits BY IP, so on a shared deployment every visitor
# competes for the same budget — a single generation uses up to ~11 queries.
#
# Free at https://account.ncbi.nlm.nih.gov/settings/
NCBI_API_KEY=

# ── Server ─────────────────────────────────────────────────────────────────
# Port to listen on. Hosting platforms usually set this for you.
PORT=5000

# Bind address. Defaults to 127.0.0.1 (local only). Set 0.0.0.0 to expose the
# server to your network or a container host.
HOST=127.0.0.1

# Flask debug mode. Leave empty. Setting this to 1 enables the Werkzeug
# debugger, which allows arbitrary code execution by anyone who can trigger a
# traceback — it is for local development only, never a reachable instance.
NANOSYNTH_DEBUG=
